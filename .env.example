SESSION_SECRET=change-me
ADMIN_PASSWORD_HASH=$2b$10$replace_with_bcrypt_hash

# 訓練執行器：local（預設）或 modal。
TRAINING_EXECUTOR=local

# TRAINING_EXECUTOR=modal 且使用自訂 Modal Web wrapper 時必填。
# 正式環境請使用公開 HTTPS URL；Modal trainer 必須能連線到 PUBLIC_BASE_URL
# 才能回傳 callback。內建 Web wrapper 會自動注入這些 URL。
PUBLIC_BASE_URL=https://app.example.invalid
MODAL_CONTROL_URL=https://modal-control.example.invalid
MODAL_CONTROL_TOKEN=replace-with-modal-control-token
MODAL_CALLBACK_TOKEN=replace-with-modal-callback-token

# Modal GPU trainer 的並行容器上限；預設 5。提高會增加 GPU 成本與 Volume contention。
MODAL_TRAINER_MAX_CONTAINERS=5

# 選填。Modal Web wrapper 通常會自動注入 shared-volume helper 的 loopback URL；
# 沒有 helper 時留白。
MODAL_VOLUME_HELPER_URL=
