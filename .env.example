SESSION_SECRET=change-me
ADMIN_PASSWORD_HASH=$2b$10$replace_with_bcrypt_hash

# 訓練執行器：local（預設）或 modal。
TRAINING_EXECUTOR=local

# TRAINING_EXECUTOR=modal 時由內建 Web wrapper 自動注入 loopback helper。
# 僅自訂 wrapper 需要填寫；URL 必須指向相同容器內的 control helper。
MODAL_CONTROL_URL=

# Modal GPU trainer 的並行容器上限；預設 5。提高會增加 GPU 成本與 Volume contention。
MODAL_TRAINER_MAX_CONTAINERS=5

# 選填。Modal Web wrapper 通常會自動注入 shared-volume helper 的 loopback URL；
# 沒有 helper 時留白。
MODAL_VOLUME_HELPER_URL=
