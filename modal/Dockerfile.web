# CPU-only image for the public web function.  The GPU/LFS toolchain is kept
# in Dockerfile.gpu so API cold starts never download CUDA or compile C++.
FROM node:22-bookworm AS web-build

RUN corepack enable
WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY backend/package.json ./backend/package.json
COPY frontend/package.json ./frontend/package.json
RUN pnpm install --frozen-lockfile

COPY scripts ./scripts
COPY .env.example ./.env.example
COPY backend ./backend
COPY frontend ./frontend
RUN pnpm --filter @lichtfeld/frontend build \
    && pnpm --filter @lichtfeld/backend build

FROM node:22-bookworm

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip \
    && ln -sf /usr/bin/python3 /usr/local/bin/python \
    && ln -sf /usr/bin/pip3 /usr/local/bin/pip \
    && rm -rf /var/lib/apt/lists/*

COPY modal/requirements.txt /tmp/modal-requirements.txt
RUN python3 -m pip install --break-system-packages --no-cache-dir \
    -r /tmp/modal-requirements.txt \
    && rm -f /tmp/modal-requirements.txt

WORKDIR /app
COPY --from=web-build /app /app

ENV MODAL_NODE_ROOT=/app
ENV PYTHONUNBUFFERED=1
EXPOSE 3000
